+
+    _log.info("build_precomputed_npz: 转换 %d 个函数 → %s", N, output_path)
+
+    # 预分配
+    token_ids = np.zeros((N, max_seq_len), dtype=np.int16)
+    jump_mask = np.zeros((N, max_seq_len), dtype=np.int8)
